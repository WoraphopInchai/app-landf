// UP Lost & Found - Firebase Storage Rules
// วิธีใช้งาน: Firebase Console -> Storage -> Rules -> วางโค้ดนี้แทนทั้งหมด -> Publish
// หรือใช้ Firebase CLI: firebase deploy --only storage:rules

// หมายเหตุ: รูปภาพทั้งหมด (โพสต์ของหาย/ของพบ, หลักฐานการขอรับของ)
// ถูกอัปโหลดผ่าน Cloudinary (ใช้ลิงก์ HTTPS สาธารณะ)
// จึงไม่มีการอัปโหลด/อ่านไฟล์บน Firebase Storage ซึ่งง่ายกว่าในการดูแลสิทธิ์

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ---------- รูปประกอบโพสต์ของหาย/ของพบ ----------
    // (รุ่นเก่า) อัปโหลดได้เฉพาะเจ้าของไฟล์ (userId == auth.uid)
    // อ่านได้เฉพาะผู้ที่ล็อกอิน
    match /posts-images/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // อนุญาตให้อ่านได้เฉพาะผู้ล็อกอินเท่านั้น (โดยค่าเริ่มต้นไฟล์อื่นถูกปฏิเสธ)
    match /chat-images/{chatId}/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
